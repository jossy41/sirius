# Sirius cloud library (Supabase).
# Leave both values empty to run fully on-device.
# Copy this file to .env.local for local development. Never commit .env.local.
#
# The anon key is public by design and is safe to expose to the browser.
# Do NOT put the service role key, database password, or any secret in a
# VITE_ variable. Those would be shipped to every student.
#
# Remote URLs must be https. http is accepted only for localhost.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
